# Environment Configuration Template
# Copy this file to .env and fill in the values for production deployment,
# or to .env.local for local testing.

# URL of the blog's JSON feed to poll (e.g., https://example.com/feed.json)
JSON_FEED_URL=https://example.com/index.json

# Base URL of the target Fediverse/GotoSocial/Mastodon instance (e.g., https://mastodon.social)
FEDIVERSE_INSTANCE_URL=https://gts.example.com

# OAuth Access Token for status posting permissions
FEDIVERSE_ACCESS_TOKEN=your_oauth_access_token_here

# Email address to subscribe to SNS new post notifications (for AWS deployment)
NOTIFICATION_EMAIL=alerts@example.com
